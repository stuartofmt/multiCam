# --------------------------------------------------
# Configuration parameters for multiCam
# Optional parameters can be commented out with ;
# In which case, defaults will be used as appropriate
# parameter values should not be quoted
# ---------------------------------------------------


# --------------------------------------------------------
# This section specifies the main configuration
# A minimal configuration requires
# [UI] and [CAMERAS]
# --------------------------------------------------------

[UI]
# Settings for UI components
# Accessed at either http://localhost or http://<DUETIP>
# PORT cannot conflict with other apps / plugins / or DWC
# PORT must be between 1024 and 65535
# Mandatory e.g. PORT = 8001

PORT = 8044

[LOGGING]
# Sets the logging detail
# Valid entries [WARNING,INFO,DEBUG]
# Optional
#Default is INFO

LEVEL = DEBUG

[CAMERAS]
# for ech camera enter the name and source
# as name=source  DO NOT USE QUOTES
# each name must be unique, each source nust be unique
# e.g.  Cam1= /dev/video0     
 
Cam1=/dev/video0
;Cam 2=/dev/video2
;IP Camera=http://192.168.30.31:8081
;TestCam = rtsp://127.0.0.1:8554/stream
Cam1Loopback = http://192.168.30.41:8044/Cam1/stream
;Loopback 2 = http://192.168.30.41:8044/Cam 2/stream
;PiLoop = http://192.168.30.41:8044/Picamera/stream

[PICAMERAS]
# Each entry adds one Picamera.
# as name=index (usually 0 if only one pi camera)
;Picamera=0

# ----------------------------------------------------------------
# Optional per-camera settings.
# Section name MUST MATCH the camera name in [CAMERAS] or [PICAMERAS]
# Any parameter you omit fall back to a default.
# Note that the setting will only work if supported by the camera
# Allowed options are:
# fps,width,height,rotation, brightness,contrast,focus,balance
# Any options must be provided with numeric values
# Consult your camera specifications for the expected values

[Cam1]
;brightness = 1
;balance = 1
fps = 15
;contrast = 10
;saturation = 20
width = 1600
height = 480
;wrong = 1

[Cam2]
;brightness = 1.5
;fps = 60
;contrast = 0
;saturation = 20
;width = 640
;height = 480

[Picamera]
;brightness = 0
;rotate = 90
;jpegresolution = 50


