# --------------------------------------------------
# Camera parameters for multiCam
# ---------------------------------------------------

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
# DO NOT EDIT BELOW THIS LINE
# USE THE CONFIGURATION PAGE AT http://<IP>:<PORT>/Settings
# TO MANAGE CAMERAS
# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

[USBCAMERAS]
Camera1 = /dev/video0

[PICAMERAS]

Camera2 = 0
[STREAMS]

[LOGGING]
loglevel = INFO

[Camera1]
brightness = 100
